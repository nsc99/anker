ANKER_SYNC_URL=http://127.0.0.1:27701
ANKER_USERNAME=your-sync-user
ANKER_PASSWORD=replace-me
# ANKER_PASSWORD_FILE=/run/secrets/anki-password
ANKER_TIMEZONE=Europe/Berlin
ANKER_LISTEN=127.0.0.1:8080
ANKER_DATA_DIR=data
ANKER_SYNC_INTERVAL=15m
ANKER_SYNC_TIMEOUT=5m
ANKER_STALE_AFTER=30m
# PostgreSQL mode: all durable state lives in the database; no SQLite volume.
# ANKER_DATABASE_URL=postgresql://anker:password@127.0.0.1:5432/anker?sslmode=verify-full
# ANKER_DATABASE_URL_FILE=/run/secrets/anker-database-url
